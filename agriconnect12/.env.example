# Copy this file to .env and update values for your local environment.
PORT=5000

# Comma-separated frontend origins. If you serve the frontend from this Express
# app, it is same-origin and does not require a CORS entry.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# Set this to the absolute path of a Firebase service-account JSON file stored
# OUTSIDE the repository. Never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json
